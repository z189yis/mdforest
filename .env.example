# PostgreSQL
DATABASE_URL="postgresql://mdforest:mdforest@localhost:5432/mdforest"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Data directory for cloned repos
DATA_DIR="./data/repos"

# WebSocket server
WS_PORT=3001
WS_HOST=0.0.0.0

# Collaboration
COLLAB_ENABLED=false           # feature flag: enable multi-user collaboration
SNAPSHOT_INTERVAL_MS=30000     # how often to persist snapshots (ms)
DOC_LRU_MAX=100                # max documents cached in memory
UPDATE_MAX_SIZE=5242880        # max WS message size (5MB)
TICKET_TTL_MS=30000            # WS auth ticket lifetime (30s)

# TLS (production)
# TLS_CERT_PATH=/etc/ssl/cert.pem
# TLS_KEY_PATH=/etc/ssl/key.pem
