generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  repos            Repo[]
  documents        Document[]
  repoCollaborations  RepoCollaborator[]
  docCollaborations   DocumentCollaborator[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repo {
  id            String    @id @default(cuid())
  name          String
  remoteUrl     String
  localPath     String    @default("")
  defaultBranch String    @default("main")
  cloneStatus   String    @default("pending")
  cloneError    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownerId     String
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents     Document[]
  commitCache   CommitCache[]
  collaborators RepoCollaborator[]
  inviteTokens  InviteToken[]
}

model CommitCache {
  id           String   @id @default(cuid())
  repoId       String
  commitHash   String
  shortHash    String
  parentHashes String   @default("[]")
  authorName   String
  authorEmail  String?
  authorDate   DateTime
  message      String
  messageBody  String?
  isMerge      Boolean  @default(false)
  branches     String   @default("[]")
  tags         String   @default("[]")

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  bindings CommitDocumentBinding[]

  @@unique([repoId, commitHash])
  @@index([repoId])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  filename  String
  content   String   @default("")
  filePath  String?
  leafX     Float?
  leafY     Float?
  isPublic  Boolean  @default(false)
  lastSnapshot     Bytes?
  snapshotVersion  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repoId  String
  repo    Repo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  ownerId String
  owner   User  @relation(fields: [ownerId], references: [id])

  bindings         CommitDocumentBinding[]
  collaborators    DocumentCollaborator[]
  documentUpdates  DocumentUpdate[]

  @@index([repoId])
}

model CommitDocumentBinding {
  id         String   @id @default(cuid())
  commitId   String
  documentId String
  createdAt  DateTime @default(now())

  commit   CommitCache @relation(fields: [commitId], references: [id], onDelete: Cascade)
  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([commitId, documentId])
  @@index([commitId])
  @@index([documentId])
}

model RepoCollaborator {
  id       String   @id @default(cuid())
  repoId   String
  userId   String
  role     String   @default("editor") // admin | editor | viewer
  joinedAt DateTime @default(now())

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, userId])
}

model DocumentCollaborator {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  role       String   @default("editor") // editor | viewer
  joinedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

model InviteToken {
  id        String    @id @default(cuid())
  repoId    String
  token     String    @unique
  role      String    @default("editor")
  usedBy    String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model DocumentUpdate {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  data       Bytes                        // Yjs binary update (WAL)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
}
